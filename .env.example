# Copy to .env and fill in values. Never commit .env.
# Names are listed in docs/SiteSync-Control-Centre-Specification.md §10.

# Docker Postgres superuser (container admin only; the app never uses it)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=sitesync

# Roles created by docker/initdb on first start
SITESYNC_OWNER_PASSWORD=
SITESYNC_APP_PASSWORD=

# Runtime connection (role sitesync_app)
DATABASE_URL=postgres://sitesync_app:<SITESYNC_APP_PASSWORD>@127.0.0.1:5432/sitesync
# Migrations / backups (role sitesync_owner)
DATABASE_OWNER_URL=postgres://sitesync_owner:<SITESYNC_OWNER_PASSWORD>@127.0.0.1:5432/sitesync

# Disposable test database (created by docker/initdb)
DATABASE_URL_TEST=postgres://sitesync_app:<SITESYNC_APP_PASSWORD>@127.0.0.1:5432/sitesync_test
DATABASE_OWNER_URL_TEST=postgres://sitesync_owner:<SITESYNC_OWNER_PASSWORD>@127.0.0.1:5432/sitesync_test

# Origin the browser uses; mutating Route Handlers require a matching Origin header
SITESYNC_APP_ORIGIN=http://127.0.0.1:3000

# LAN mode — see docs/lan-mode.md. Both must be set to take effect.
SITESYNC_LAN_MODE=false
SITESYNC_PUBLIC_ORIGIN=

# Optional: set to "off" to run without the background job runner (manual refreshes then run inline).
SITESYNC_JOBS=

# Optional provider credentials (docs/github.md). Names are your choice; these are suggestions.
# SiteSync stores only the name you enter on the Integrations screen, never the value.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
